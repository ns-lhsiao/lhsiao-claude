# Deny-by-default: ignore everything, then allowlist tracked files.
*

# Tracked config files
!.gitignore
!CLAUDE.md
!LEARNINGS.md
!settings.json
# mcp.json contains API tokens — do NOT track
mcp.json

# Scripts
!scripts/
!scripts/**

# Skills (personal only — marketplace plugin skills are in plugins/)
!skills/
!skills/learn/
!skills/learn/**
!skills/reground/
!skills/reground/**
!skills/finish-up/
!skills/finish-up/**
!skills/quick-implement/
!skills/quick-implement/**
!skills/boot-troubleshoot/
!skills/boot-troubleshoot/**
!skills/boot-feature/
!skills/boot-feature/**
!skills/boot-bugfix/
!skills/boot-bugfix/**
!skills/init-dev-env/
!skills/init-dev-env/**
!skills/mf-client-playwright/
!skills/mf-client-playwright/SKILL.md
# .env in mf-client-playwright contains credentials — stays ignored by default
!skills/ngs-ticket-creator/
!skills/ngs-ticket-creator/**
!skills/cm-ticket-creator/
!skills/cm-ticket-creator/**
!skills/ui-client-hygiene-review/
!skills/ui-client-hygiene-review/**
!skills/where-am-i/
!skills/where-am-i/**
!skills/contract-probe/
!skills/contract-probe/**
!skills/restack-pr/
!skills/restack-pr/**
!skills/helm-recover/
!skills/helm-recover/**
!skills/form-field-inventory/
!skills/form-field-inventory/**
!skills/component-split/
!skills/component-split/**
!skills/review-new-code-coverage/
!skills/review-new-code-coverage/**
!skills/sidecar/
!skills/sidecar/**
!skills/webui-devbox-playwright/
!skills/webui-devbox-playwright/**

# Slash commands (global custom commands)
!commands/
!commands/**

# Hooks
!hooks/
!hooks/**

# Agents (custom subagent definitions)
!agents/
!agents/**

# Explicitly ignore ephemeral/sensitive directories
backups/
cache/
debug/
downloads/
file-history/
history.jsonl
ide/
paste-cache/
plans/
plugins/
projects/
session-env/
sessions/
settings.local.json
shell-snapshots/
tasks/
teams/
usage-data/
.DS_Store
