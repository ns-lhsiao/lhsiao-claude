{
  "awsAuthRefresh": "aws sso login --profile NSBedrockViewer-242201274356",
  "env": {
    "AWS_PROFILE": "NSBedrockViewer-242201274356",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "model": "us.anthropic.claude-opus-4-6-v1",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/pr-statusline.sh"
  },
  "extraKnownMarketplaces": {
    "netskope": {
      "source": {
        "source": "github",
        "repo": "netSkope/claude-skills"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/compact-nudge.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/daily-cost-alert.py"
          }
        ]
      }
    ]
  }
}
